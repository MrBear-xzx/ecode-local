{
  "name": "ecode-vscode",
  "displayName": "Ecode Local",
  "description": "泛微 Ecode 本地开发扩展：安全同步、冲突保护、API/组件智能与选择性发布",
  "version": "0.7.1",
  "publisher": "ecode-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrBear-xzx/ecode-local.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ecode",
    "泛微",
    "e-cology",
    "本地开发",
    "同步",
    "intellisense",
    "ecCom"
  ],
  "activationEvents": [
    "onCommand:ecode.setup",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ecode.configure",
        "title": "Ecode: 配置当前环境",
        "icon": "$(gear)"
      },
      {
        "command": "ecode.addEnvironment",
        "title": "Ecode: 新增环境",
        "icon": "$(add)"
      },
      {
        "command": "ecode.switchEnvironment",
        "title": "Ecode: 切换环境",
        "icon": "$(server-environment)"
      },
      {
        "command": "ecode.deleteEnvironment",
        "title": "Ecode: 删除环境及本地数据",
        "icon": "$(trash)"
      },
      {
        "command": "ecode.pull",
        "title": "Ecode: 全量拉取",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ecode.refreshChanges",
        "title": "Ecode: 刷新本地与远端变更",
        "icon": "$(refresh)"
      },
      {
        "command": "ecode.pushSelected",
        "title": "Ecode: 选择并推送",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ecode.rollbackPushFile",
        "title": "Ecode: 回退此文件到推送前",
        "icon": "$(discard)"
      },
      {
        "command": "ecode.renamePushRecord",
        "title": "Ecode: 重命名推送记录",
        "icon": "$(edit)"
      },
      {
        "command": "ecode.deletePushRecord",
        "title": "Ecode: 删除推送记录",
        "icon": "$(trash)"
      },
      {
        "command": "ecode.openDiff",
        "title": "Ecode: 查看差异",
        "icon": "$(diff)"
      },
      {
        "command": "ecode.revertChange",
        "title": "Ecode: 回退本地变更",
        "icon": "$(discard)"
      },
      {
        "command": "ecode.resolveConflict",
        "title": "Ecode: 解决冲突",
        "icon": "$(issues)"
      },
      {
        "command": "ecode.createChangeSet",
        "title": "Ecode: 创建跨环境变更集",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "ecode.applyChangeSet",
        "title": "Ecode: 应用变更集到当前环境",
        "icon": "$(rocket)"
      },
      {
        "command": "ecode.deleteChangeSet",
        "title": "Ecode: 删除变更集",
        "icon": "$(trash)"
      },
      {
        "command": "ecode.searchApiDocumentation",
        "title": "Ecode: 搜索开发文档",
        "icon": "$(search)"
      },
      {
        "command": "ecode.openOnlineDocumentation",
        "title": "Ecode: 打开官方文档",
        "icon": "$(book)"
      },
      {
        "command": "ecode.refreshAiSupport",
        "title": "Ecode: 刷新 AI Coding 支持",
        "icon": "$(sparkle)"
      },
      {
        "command": "ecode.enableAiSupport",
        "title": "Ecode: 启用 AI Coding 支持",
        "icon": "$(sparkle)"
      },
      {
        "command": "ecode.openAiGuide",
        "title": "Ecode: 打开 AI Coding 指南",
        "icon": "$(book)"
      },
      {
        "command": "ecode.removeAiSupport",
        "title": "Ecode: 移除 AI Coding 支持",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ecode",
          "title": "Ecode",
          "icon": "media/ecode.svg"
        }
      ]
    },
    "views": {
      "ecode": [
        {
          "id": "ecode.workspace",
          "name": "工作区",
          "icon": "media/ecode.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "ecode.rollbackPushFile",
          "when": "false"
        },
        {
          "command": "ecode.renamePushRecord",
          "when": "false"
        },
        {
          "command": "ecode.deletePushRecord",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "ecode.configure",
          "when": "view == ecode.workspace",
          "group": "1_connection@1"
        },
        {
          "command": "ecode.addEnvironment",
          "when": "view == ecode.workspace",
          "group": "1_connection@2"
        },
        {
          "command": "ecode.switchEnvironment",
          "when": "view == ecode.workspace",
          "group": "1_connection@3"
        },
        {
          "command": "ecode.createChangeSet",
          "when": "view == ecode.workspace",
          "group": "2_promotion@1"
        },
        {
          "command": "ecode.applyChangeSet",
          "when": "view == ecode.workspace",
          "group": "2_promotion@2"
        },
        {
          "command": "ecode.pull",
          "when": "view == ecode.workspace",
          "group": "navigation@1"
        },
        {
          "command": "ecode.refreshChanges",
          "when": "view == ecode.workspace",
          "group": "navigation@2"
        },
        {
          "command": "ecode.pushSelected",
          "when": "view == ecode.workspace",
          "group": "navigation@3"
        },
        {
          "command": "ecode.searchApiDocumentation",
          "when": "view == ecode.workspace",
          "group": "3_documentation@1"
        },
        {
          "command": "ecode.openOnlineDocumentation",
          "when": "view == ecode.workspace",
          "group": "3_documentation@2"
        },
        {
          "command": "ecode.openAiGuide",
          "when": "view == ecode.workspace",
          "group": "3_documentation@3"
        },
        {
          "command": "ecode.refreshAiSupport",
          "when": "view == ecode.workspace && ecode.aiSupportEnabled",
          "group": "4_ai@1"
        },
        {
          "command": "ecode.enableAiSupport",
          "when": "view == ecode.workspace && !ecode.aiSupportEnabled",
          "group": "4_ai@1"
        },
        {
          "command": "ecode.removeAiSupport",
          "when": "view == ecode.workspace && ecode.aiSupportEnabled",
          "group": "4_ai@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ecode.deleteEnvironment",
          "when": "view == ecode.workspace && viewItem =~ /ecode.environment/",
          "group": "inline@1"
        },
        {
          "command": "ecode.openDiff",
          "when": "view == ecode.workspace && viewItem =~ /ecode.change/",
          "group": "inline@1"
        },
        {
          "command": "ecode.resolveConflict",
          "when": "view == ecode.workspace && viewItem == ecode.change.conflict",
          "group": "inline@2"
        },
        {
          "command": "ecode.revertChange",
          "when": "view == ecode.workspace && viewItem == ecode.change.revertible",
          "group": "inline@2"
        },
        {
          "command": "ecode.rollbackPushFile",
          "when": "view == ecode.workspace && viewItem == ecode.pushRecordFile",
          "group": "inline@1"
        },
        {
          "command": "ecode.renamePushRecord",
          "when": "view == ecode.workspace && viewItem == ecode.pushRecord",
          "group": "inline@1"
        },
        {
          "command": "ecode.deletePushRecord",
          "when": "view == ecode.workspace && viewItem == ecode.pushRecord",
          "group": "inline@2"
        },
        {
          "command": "ecode.applyChangeSet",
          "when": "view == ecode.workspace && viewItem == ecode.changeSet",
          "group": "inline@1"
        },
        {
          "command": "ecode.deleteChangeSet",
          "when": "view == ecode.workspace && viewItem == ecode.changeSet",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Ecode Local",
      "properties": {
        "ecode.intelligence.enabled": {
          "type": "boolean",
          "default": true,
          "description": "为 ecodeSDK、ModeForm、ModeList、WfForm、ecCom 和内置 antd 启用成员与二级对象参数联想、表单字段元数据联想与跳转、setCom/getCom 工作区导航、参数/props 提示、悬停说明及文档跳转。"
        },
        "ecode.aiSupport.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "在 .ecode-local/common/ecode-ai 中生成公共知识，并在当前环境目录下生成项目知识，同时维护工作区根目录 AGENTS.md 的 Ecode 管理区块。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src",
    "test": "node -e \"require('fs').rmSync('out/test',{recursive:true,force:true})\" && tsc && node ./out/test/runTest.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "glob": "^11.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@babel/standalone": "7.5.5"
  }
}
